# ---- Rewards ----
# R: <joint_action> : <start_state> : <end_state> : <joint_obs> : <reward>
# Both listen: -2 per agent (joint reward = -2)
R: listen listen : tiger-left : * : * : -2.0
R: listen listen : tiger-right : * : * : -2.0

# Both open-left: tiger-right -> both safe -> +20; tiger-left -> both wrong -> -50
R: open-left open-left : tiger-left : * : * : -50.0
R: open-left open-left : tiger-right : * : * : 20.0

# Both open-right: tiger-left -> both safe -> +20; tiger-right -> both wrong -> -50
R: open-right open-right : tiger-left : * : * : 20.0
R: open-right open-right : tiger-right : * : * : -50.0

# Mismatch: one opens wrong door, other opens right door -> -50 each
R: open-left open-right : * : * : * : -50.0
R: open-right open-left : * : * : * : -50.0

# One listens, other opens: uncoordinated -> -101 each
R: listen open-left : * : * : * : -101.0
R: listen open-right : * : * : * : -101.0
R: open-left listen : * : * : * : -101.0
R: open-right listen : * : * : * : -101.0
